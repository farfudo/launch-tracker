# API database; export this variable before starting FastAPI.
DATABASE_URL=postgresql+psycopg://launch_tracker:launch_tracker@localhost:5433/launch_tracker

# Server-side URL; set in apps/web/.env.local for local Next.js.
API_BASE_URL=http://127.0.0.1:8000

# Isolated Docker demo: choose a URL-safe password before starting.
DEMO_DATABASE_PASSWORD=replace-with-a-long-random-url-safe-password
